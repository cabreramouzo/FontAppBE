DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=vapor
DATABASE_PASSWORD=vapor
DATABASE_NAME=fontapp
APP_SECRET=dev-only-not-a-secret
# Gamification on in local dev: without GAMIFICATION_WORKER the background scorer
# never runs, so contributions don't turn into drops/levels until you run
# `swift run App gamification-sync` by hand — which makes it look broken locally.
# Capabilities need the flag plus a past epoch to be granted (see CLAUDE.md).
GAMIFICATION_WORKER=true
GAMIFICATION_CAPABILITIES=true
GAMIFICATION_EPOCH=2024-01-01
