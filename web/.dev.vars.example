# Copy this file to .dev.vars and use Stripe TEST-mode values.
# Never prefix the secret with VITE_: Vite would expose it to the browser.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_ONE_TIME_PRICE_ID=price_replace_me

# Only needed if Stripe monthly donations are exposed again in the UI.
STRIPE_MONTHLY_PRICE_ID=price_replace_me
