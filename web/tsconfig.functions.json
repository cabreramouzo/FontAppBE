{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.functions.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    /* Las funciones de Pages corren en el runtime de Workers, no en el navegador ni en
       Node: `PagesFunction`, `HTMLRewriter` y el `cf` de `fetch` salen de aquí. Es un
       paquete solo de tipos, sin código. */
    "types": ["@cloudflare/workers-types"],
    "skipLibCheck": true,

    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["functions"]
}
